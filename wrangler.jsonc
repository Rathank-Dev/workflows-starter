/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flowyard",
	"account_id": "1a5db39abcf7968b969241c2bc0cdd18",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	// postgres.js uses Node APIs (TCP sockets via cloudflare:sockets, crypto)
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		// Sign-in redirects are browser navigations; send them to the Worker, not index.html
		"run_worker_first": ["/api/*", "/auth/*", "/ws"]
	},
	"observability": {
		"enabled": true
	},
	/**
	 * Hyperdrive: pooled, TLS-terminating connection to Postgres.
	 * Create it once with:
	 *   npx wrangler hyperdrive create linework-db --connection-string="$DATABASE_URL"
	 * then paste the id below. Local dev reads the connection string from
	 * CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (set by `npm run dev`).
	 */
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "9a4582478a374aca926731f681d1b3d1"
		}
	],
	/**
	 * Rate limits (Workers Rate Limiting). period must be 10 or 60 seconds.
	 * REQUEST_LIMITER: per IP address, for /api and /auth.
	 * AI_LIMITER: per signed-in user, a burst cap on the assistant on top of
	 * its daily limit.
	 */
	"ratelimits": [
		{ "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
		{ "name": "AI_LIMITER", "namespace_id": "1002", "simple": { "limit": 8, "period": 60 } }
	],
	/**
	 * Workers AI: models that run on Cloudflare, no API key. Billed to your
	 * Cloudflare account (with a free daily allowance). Local dev calls the real
	 * service, so run `npx wrangler login` once to use it from `npm run dev`.
	 */
	"ai": {
		"binding": "AI"
	},
	/**
	 * Durable Objects
	 * One BoardDO per board: stores the document and relays live edits
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "BOARD",
				"class_name": "BoardDO"
			}
		]
	},
	/**
	 * Migrations
	 * Required for Durable Objects
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BoardDO"]
		}
	],
	"upload_source_maps": true
}
