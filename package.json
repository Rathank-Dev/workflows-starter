{
	"name": "workflows-starter",
	"description": "Interactive starter template demonstrating Cloudflare Workflows with real-time status updates",
	"cloudflare": {
		"label": "Workflows Starter",
		"products": [
			"Workers",
			"Workflows",
			"Durable Objects"
		],
		"categories": [
			"starter"
		],
		"publish": true,
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/4380d39a-b907-437c-e784-500fcc10cb00/preview",
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/6d6e9a49-5c10-4ef6-bfa8-b6577a656300/public",
		"docs_url": "https://developers.cloudflare.com/workflows/"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.133.0",
		"arctic": "^3.7.0",
		"postgres": "^3.4.9",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.63.1",
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@eslint/js": "9.39.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react-swc": "4.3.3",
		"@vitest/runner": "4.1.11",
		"@vitest/snapshot": "4.1.11",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.5.7",
		"globals": "17.13.0",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.1",
		"vite": "^8.3.4",
		"vitest": "4.1.11",
		"wrangler": "4.149.0"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "tsc && wrangler deploy --dry-run",
		"deploy": "npm run build && node scripts/deploy.mjs",
		"dev": "node scripts/dev.mjs",
		"lint": "eslint .",
		"preview": "npm run build && node scripts/dev.mjs preview",
		"test": "vitest run",
		"db:migrate": "node scripts/migrate.mjs"
	},
	"type": "module",
	"overrides": {
		"@cloudflare/vitest-pool-workers": {
			"wrangler": "4.149.0",
			"miniflare": "5.20261001.0-alpha"
		},
		"undici": "^7.30.0",
		"sharp": "^0.35.5"
	}
}
